<UserControl
    x:Class="DatabaseAuditor.WPF.Controls.LoadingSpinner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsVisibleChanged="OnVisibleChanged">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Spinner Ring -->
        <Grid Grid.Row="0"
              Width="{Binding SpinnerSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
              Height="{Binding SpinnerSize, RelativeSource={RelativeSource AncestorType=UserControl}}">

            <!-- Track Ring -->
            <Ellipse
                Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="3"
                Fill="Transparent"/>

            <!-- Spinning Arc -->
            <Path x:Name="SpinnerArc"
                  Stroke="{DynamicResource AccentBrush}"
                  StrokeThickness="3"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Fill="Transparent"
                  RenderTransformOrigin="0.5,0.5">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="18,3" IsClosed="False">
                            <ArcSegment
                                Point="33,18"
                                Size="15,15"
                                SweepDirection="Clockwise"
                                IsLargeArc="False"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
                <Path.RenderTransform>
                    <RotateTransform x:Name="SpinRotate" Angle="0"
                                     CenterX="18" CenterY="18"/>
                </Path.RenderTransform>
            </Path>
        </Grid>

        <!-- Message -->
        <TextBlock
            Grid.Row="2"
            x:Name="MessageText"
            Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Style="{StaticResource TextCaption}"
            HorizontalAlignment="Center"
            Visibility="{Binding HasMessage,
                RelativeSource={RelativeSource AncestorType=UserControl},
                Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</UserControl>