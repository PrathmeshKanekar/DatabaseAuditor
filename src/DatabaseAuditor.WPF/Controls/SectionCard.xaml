<UserControl
    x:Class="DatabaseAuditor.WPF.Controls.SectionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Accent Bar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="2"
                        Width="4"
                        Height="22"/>

                <!-- Title + Subtitle -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding Title,
                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource TextHeading3}"/>
                    <TextBlock
                        Text="{Binding Subtitle,
                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource TextCaption}"
                        Margin="0,2,0,0"
                        Visibility="{Binding HasSubtitle,
                            RelativeSource={RelativeSource AncestorType=UserControl},
                            Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- Header Actions Slot -->
                <ContentPresenter
                    Grid.Column="3"
                    Content="{Binding HeaderContent,
                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                    VerticalAlignment="Center"/>
            </Grid>

            <!-- Divider -->
            <Separator Grid.Row="1" Margin="0"/>

            <!-- Body Content -->
            <ContentPresenter
                Grid.Row="2"
                Content="{Binding Content,
                    RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Grid>
    </Border>
</UserControl>