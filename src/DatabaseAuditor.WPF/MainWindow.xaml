<Window x:Class="DatabaseAuditor.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DatabaseAuditor.WPF"
        xmlns:controls="clr-namespace:DatabaseAuditor.WPF.Controls"
        xmlns:viewmodels="clr-namespace:DatabaseAuditor.WPF.ViewModels"
        mc:Ignorable="d"
        Title="Database Schema Auditor" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Navigation Sidebar -->
            <ColumnDefinition Width="Auto" />
            <!-- Main Content Area -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" 
                Width="240"
                Background="{DynamicResource SurfaceCardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,1,0"
                x:Name="SidebarBorder">
            <Grid Margin="12,16,12,12">
                <Grid.RowDefinitions>
                    <!-- Header/Brand -->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <!-- Navigation List -->
                    <RowDefinition Height="*" />
                    <!-- Footer / Theme Toggle -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand/Logo -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="⛁" FontSize="28" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="4,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="DATABASE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="AUDITOR" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,-2,0,0"/>
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="1" Background="{DynamicResource BorderBrush}" Height="1" VerticalAlignment="Bottom"/>

                <!-- Navigation List -->
                <ListBox Grid.Row="2"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,16,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusMD}" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="IconText"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                                                <Setter TargetName="IconText" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="IconText" Property="Foreground" Value="White"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <!-- Handle click in code-behind / binding -->
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Empty, template is fully defined in container style -->
                            <Grid/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer and Settings / Theme Toggle -->
                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <Button Command="{Binding ToggleThemeCommand}"
                            Style="{DynamicResource ButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Padding="8,10"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding IsDarkTheme, Converter={StaticResource EnumToStringConverter}, ConverterParameter=ThemeIcon}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding IsDarkTheme, Converter={StaticResource EnumToStringConverter}, ConverterParameter=ThemeText}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <TextBlock Text="Three Star Infotech" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Title Header -->
                <RowDefinition Height="56" />
                <!-- Content Body -->
                <RowDefinition Height="*" />
                <!-- Status Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="{Binding CurrentPageName}" Style="{DynamicResource TextHeading3}" VerticalAlignment="Center"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Extra action or status could go here -->
                        <TextBlock Text="Active Session: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentPageName, Converter={StaticResource PageNameToViewConverter}}"/>

            <!-- Loading Overlay -->
            <Grid Grid.Row="1" Background="#80000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <controls:LoadingSpinner SpinnerSize="48" Message="Loading operations..." HasMessage="True"/>
            </Grid>

            <!-- Footer Status Bar -->
            <Border Grid.Row="2" Style="{DynamicResource StatusBarStyle}">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{DynamicResource TextCaption}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Ready" Style="{DynamicResource TextCaption}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
