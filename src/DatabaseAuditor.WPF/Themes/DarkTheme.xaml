<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== BACKGROUND ===================== -->
    <Color x:Key="BackgroundColor">#FF1E1E1E</Color>
    <Color x:Key="SurfaceColor">#FF252526</Color>
    <Color x:Key="SurfaceElevatedColor">#FF2D2D30</Color>
    <Color x:Key="SurfaceCardColor">#FF2D2D30</Color>
    <Color x:Key="BorderColor">#FF3F3F46</Color>
    <Color x:Key="DividerColor">#FF3F3F46</Color>

    <!-- ===================== ACCENT ===================== -->
    <Color x:Key="AccentColor">#FF0078D4</Color>
    <Color x:Key="AccentHoverColor">#FF106EBE</Color>
    <Color x:Key="AccentPressedColor">#FF005A9E</Color>
    <Color x:Key="AccentLightColor">#FF1F9FFF</Color>

    <!-- ===================== TEXT ===================== -->
    <Color x:Key="TextPrimaryColor">#FFD4D4D4</Color>
    <Color x:Key="TextSecondaryColor">#FF9D9D9D</Color>
    <Color x:Key="TextDisabledColor">#FF5A5A5A</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFFFF</Color>

    <!-- ===================== NAVIGATION ===================== -->
    <Color x:Key="NavBackgroundColor">#FF1B1B1B</Color>
    <Color x:Key="NavItemHoverColor">#FF2A2A2A</Color>
    <Color x:Key="NavItemActiveColor">#FF0078D4</Color>
    <Color x:Key="NavItemActiveBgColor">#FF1A3A52</Color>

    <!-- ===================== STATUS ===================== -->
    <Color x:Key="AddedColor">#FF4CAF50</Color>
    <Color x:Key="AddedBgColor">#FF1B3A1F</Color>
    <Color x:Key="DeletedColor">#FFF44336</Color>
    <Color x:Key="DeletedBgColor">#FF3A1A1A</Color>
    <Color x:Key="ModifiedColor">#FFFFC107</Color>
    <Color x:Key="ModifiedBgColor">#FF3A2E00</Color>
    <Color x:Key="UnchangedColor">#FF9E9E9E</Color>
    <Color x:Key="SuccessColor">#FF4CAF50</Color>
    <Color x:Key="ErrorColor">#FFF44336</Color>
    <Color x:Key="WarningColor">#FFFFC107</Color>
    <Color x:Key="InfoColor">#FF2196F3</Color>

    <!-- ===================== INPUT ===================== -->
    <Color x:Key="InputBackgroundColor">#FF3C3C3C</Color>
    <Color x:Key="InputBorderColor">#FF555555</Color>
    <Color x:Key="InputFocusBorderColor">#FF0078D4</Color>

    <!-- ===================== GRID ===================== -->
    <Color x:Key="GridHeaderBgColor">#FF252526</Color>
    <Color x:Key="GridRowAltColor">#FF2A2A2A</Color>
    <Color x:Key="GridSelectionColor">#FF1A3A52</Color>
    <Color x:Key="GridBorderColor">#FF3F3F46</Color>

    <!-- ===================== BRUSHES ===================== -->
    <SolidColorBrush x:Key="BackgroundBrush"         Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"            Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush"    Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="SurfaceCardBrush"        Color="{StaticResource SurfaceCardColor}"/>
    <SolidColorBrush x:Key="BorderBrush"             Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush"            Color="{StaticResource DividerColor}"/>

    <SolidColorBrush x:Key="AccentBrush"             Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"        Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush"      Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush"        Color="{StaticResource AccentLightColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush"        Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"      Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush"       Color="{StaticResource TextDisabledColor}"/>
    <SolidColorBrush x:Key="TextOnAccentBrush"       Color="{StaticResource TextOnAccentColor}"/>

    <SolidColorBrush x:Key="NavBackgroundBrush"      Color="{StaticResource NavBackgroundColor}"/>
    <SolidColorBrush x:Key="NavItemHoverBrush"       Color="{StaticResource NavItemHoverColor}"/>
    <SolidColorBrush x:Key="NavItemActiveBrush"      Color="{StaticResource NavItemActiveColor}"/>
    <SolidColorBrush x:Key="NavItemActiveBgBrush"    Color="{StaticResource NavItemActiveBgColor}"/>

    <SolidColorBrush x:Key="AddedBrush"              Color="{StaticResource AddedColor}"/>
    <SolidColorBrush x:Key="AddedBgBrush"            Color="{StaticResource AddedBgColor}"/>
    <SolidColorBrush x:Key="DeletedBrush"            Color="{StaticResource DeletedColor}"/>
    <SolidColorBrush x:Key="DeletedBgBrush"          Color="{StaticResource DeletedBgColor}"/>
    <SolidColorBrush x:Key="ModifiedBrush"           Color="{StaticResource ModifiedColor}"/>
    <SolidColorBrush x:Key="ModifiedBgBrush"         Color="{StaticResource ModifiedBgColor}"/>
    <SolidColorBrush x:Key="UnchangedBrush"          Color="{StaticResource UnchangedColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"            Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="ErrorBrush"              Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarningBrush"            Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="InfoBrush"               Color="{StaticResource InfoColor}"/>

    <SolidColorBrush x:Key="InputBackgroundBrush"    Color="{StaticResource InputBackgroundColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush"        Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush"   Color="{StaticResource InputFocusBorderColor}"/>

    <SolidColorBrush x:Key="GridHeaderBgBrush"       Color="{StaticResource GridHeaderBgColor}"/>
    <SolidColorBrush x:Key="GridRowAltBrush"         Color="{StaticResource GridRowAltColor}"/>
    <SolidColorBrush x:Key="GridRowHoverBrush"       Color="#FF333335"/>
    <SolidColorBrush x:Key="GridSelectionBrush"      Color="{StaticResource GridSelectionColor}"/>
    <SolidColorBrush x:Key="GridBorderBrush"         Color="{StaticResource GridBorderColor}"/>

    <!-- ===================== SCROLLBAR ===================== -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush"     Color="#FF555555"/>
    <SolidColorBrush x:Key="ScrollBarTrackBrush"     Color="#FF2D2D30"/>

    <!-- ===================== SHADOW ===================== -->
    <Color x:Key="ShadowColor">#AA000000</Color>
    <SolidColorBrush x:Key="ShadowBrush"             Color="{StaticResource ShadowColor}"/>

</ResourceDictionary>