<UserControl x:Class="DatabaseAuditor.WPF.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DatabaseAuditor.WPF.Views"
             mc:Ignorable="d" 
             Padding="24"
             d:DesignHeight="600" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Compare Database Schemas" Style="{DynamicResource TextHeading2}" FontWeight="Bold"/>
                <TextBlock Text="Select source (baseline) and target (compare) database environments." Style="{DynamicResource TextCaption}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Connections Selection Card -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Source Selector -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Source Connection (Baseline)" FontWeight="SemiBold" Style="{DynamicResource TextBody}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Connections}"
                                  SelectedItem="{Binding SelectedSource}"
                                  Style="{DynamicResource ComboBoxStyle}"
                                  DisplayMemberPath="Name"
                                  Padding="10,8" />
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusSM}" Padding="12" Margin="0,8,0,0" Height="100"
                                Visibility="{Binding SelectedSource, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                            <StackPanel DataContext="{Binding SelectedSource}">
                                <TextBlock Text="{Binding DatabaseType, StringFormat='Database Type: \{0\}'}" Style="{DynamicResource TextCaption}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Server, StringFormat='Server Address: \{0\}'}" Style="{DynamicResource TextCaption}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DatabaseName, StringFormat='Database Name: \{0\}'}" Style="{DynamicResource TextCaption}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Environment, StringFormat='Environment: \{0\}'}" Style="{DynamicResource TextCaption}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Swap Button -->
                    <Button Grid.Column="1" Command="{Binding SwapConnectionsCommand}" Style="{DynamicResource ButtonStyle}" 
                            Content="⇄" FontSize="20" FontWeight="Bold" Width="48" Height="36" VerticalAlignment="Center" Margin="16,0"/>

                    <!-- Target Selector -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Target Connection (Compare)" FontWeight="SemiBold" Style="{DynamicResource TextBody}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Connections}"
                                  SelectedItem="{Binding SelectedTarget}"
                                  Style="{DynamicResource ComboBoxStyle}"
                                  DisplayMemberPath="Name"
                                  Padding="10,8"/>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusSM}" Padding="12" Margin="0,8,0,0" Height="100"
                                Visibility="{Binding SelectedTarget, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                            <StackPanel DataContext="{Binding SelectedTarget}">
                                <TextBlock Text="{Binding DatabaseType, StringFormat='Database Type: \{0\}'}" Style="{DynamicResource TextCaption}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Server, StringFormat='Server Address: \{0\}'}" Style="{DynamicResource TextCaption}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding DatabaseName, StringFormat='Database Name: \{0\}'}" Style="{DynamicResource TextCaption}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Environment, StringFormat='Environment: \{0\}'}" Style="{DynamicResource TextCaption}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Settings Card -->
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Comparison Settings" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Scope Selection -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Comparison Scope / Object Type" Style="{DynamicResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding CompareTypes}"
                                      SelectedItem="{Binding SelectedCompareType}"
                                      Style="{DynamicResource ComboBoxStyle}"
                                      DisplayMemberPath="Display"
                                      Padding="10,8" />
                        </StackPanel>

                        <!-- Options -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding IncludeUnchanged}" Style="{DynamicResource CheckBoxStyle}" Content="Include unchanged items in final report"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Action panel -->
            <Border Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <!-- Progress Section -->
                    <StackPanel Visibility="{Binding IsComparing, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,16">
                        <TextBlock Text="{Binding ProgressMessage}" Style="{DynamicResource TextCaption}" Margin="0,0,0,8"/>
                        <ProgressBar Value="{Binding ProgressValue}" IsIndeterminate="{Binding IsIndeterminate}" Height="12" Background="{DynamicResource SurfaceBrush}" BorderThickness="0"/>
                    </StackPanel>

                    <!-- Error Alert -->
                    <Border Background="#20FF0000" BorderBrush="#80FF0000" BorderThickness="1" CornerRadius="{DynamicResource RadiusMD}" Padding="16" Margin="0,0,0,16"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Comparison Error" FontWeight="Bold" Foreground="{DynamicResource DeletedBrush}" FontSize="14" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ErrorMessage}" Style="{DynamicResource TextBody}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Success Alert -->
                    <Border Background="#2000FF00" BorderBrush="#8000FF00" BorderThickness="1" CornerRadius="{DynamicResource RadiusMD}" Padding="16" Margin="0,0,0,16"
                            Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding StatusMessage}" Style="{DynamicResource TextBody}" Foreground="{DynamicResource UnchangedBrush}"/>
                    </Border>

                    <!-- Actions Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" Command="{Binding ClearCompareCommand}" Style="{DynamicResource ButtonStyle}" Content="Reset" Width="100"/>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Command="{Binding CancelCompareCommand}" Style="{DynamicResource ButtonStyle}" Content="Cancel" Width="120" Margin="0,0,8,0"
                                    Visibility="{Binding IsComparing, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Command="{Binding CompareCommand}" Style="{DynamicResource ButtonStyle}" Content="Run Comparison" Width="160" Background="{DynamicResource AccentBrush}" Foreground="White"
                                    Visibility="{Binding IsComparing, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
