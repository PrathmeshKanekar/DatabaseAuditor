<UserControl x:Class="DatabaseAuditor.WPF.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:DatabaseAuditor.WPF.Converters"
             xmlns:helpers="clr-namespace:DatabaseAuditor.WPF.Helpers"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:EnumToStringConverter x:Key="EnumStr"/>
        <converters:BoolToVisibilityConverter x:Key="BoolVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Grid Grid.Column="0">
                    <TextBox x:Name="SearchBox" TabIndex="1"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="32,6,10,6"/>
                    <TextBlock Text="🔍"
                               FontSize="13"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="Search connections…"
                               FontSize="11" FontStyle="Italic"
                               Margin="32,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource TextDisabledBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Environment Filter -->
                <ComboBox Grid.Column="2" TabIndex="2"
                          Style="{StaticResource ModernComboBoxStyle}"
                          ItemsSource="{Binding EnvironmentFilters}"
                          SelectedItem="{Binding FilterEnvironment}"/>

                <!-- Spacer -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" helpers:StackPanelHelper.Spacing="8">

                    <Button TabIndex="3" Content="+ Add Connection"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddConnectionCommand}"/>

                    <Button TabIndex="4" Content="✎ Edit"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding EditConnectionCommand}"
                            IsEnabled="{Binding SelectedConnection, Converter={StaticResource BoolVis}, ConverterParameter=notNull}"/>

                    <Button TabIndex="5" Content="🗑 Delete"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding DeleteConnectionCommand}"
                            IsEnabled="{Binding SelectedConnection, Converter={StaticResource BoolVis}, ConverterParameter=notNull}"/>

                    <Button TabIndex="6" Content="⚡ Test"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding TestConnectionCommand}"
                            IsEnabled="{Binding SelectedConnection, Converter={StaticResource BoolVis}, ConverterParameter=notNull}"/>

                    <Separator Width="1" Height="22"
                               Background="{DynamicResource BorderBrush}"
                               VerticalAlignment="Center"/>

                    <Button TabIndex="7" Content="↑ Export"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding ExportConnectionsCommand}"/>

                    <Button TabIndex="8" Content="↓ Import"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding ImportConnectionsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <DataGrid x:Name="ConnectionsGrid" TabIndex="9"
                      Style="{StaticResource AuditGridStyle}"
                      ItemsSource="{Binding FilteredConnections}"
                      SelectedItem="{Binding SelectedConnection}"
                      MouseDoubleClick="OnGridDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Status" Width="60" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Ellipse Width="8" Height="8"
                                         Fill="{DynamicResource SuccessBrush}"
                                         HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="180"
                                        FontWeight="SemiBold"/>

                    <DataGridTemplateColumn Header="Environment" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10"
                                        Padding="8,2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource SurfaceElevatedBrush}"/>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Environment,
                                                   Converter={StaticResource EnumStr}}"
                                               FontSize="10" FontWeight="SemiBold"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Database Type"
                                        Binding="{Binding DatabaseType,
                                            Converter={StaticResource EnumStr}}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Server"
                                        Binding="{Binding Server}"
                                        Width="180"/>

                    <DataGridTextColumn Header="Port"
                                        Binding="{Binding Port}"
                                        Width="70"/>

                    <DataGridTextColumn Header="Database"
                                        Binding="{Binding DatabaseName}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Username"
                                        Binding="{Binding Username}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Created"
                                        Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd}'}"
                                        Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="11"
                           FontFamily="{StaticResource PrimaryFont}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           FontSize="11"
                           FontFamily="{StaticResource PrimaryFont}"
                           Foreground="{DynamicResource TextSecondaryBrush}">
                    <Run Text="{Binding FilteredConnections.Count, Mode=OneWay}"/>
                    <Run Text=" of "/>
                    <Run Text="{Binding Connections.Count, Mode=OneWay}"/>
                    <Run Text=" connections"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
