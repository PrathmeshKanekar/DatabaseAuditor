<UserControl x:Class="DatabaseAuditor.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DatabaseAuditor.WPF.ViewModels"
             xmlns:helpers="clr-namespace:DatabaseAuditor.WPF.Helpers"
             Background="{DynamicResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" helpers:StackPanelHelper.Spacing="20">

            <!-- Welcome Banner -->
            <Border Background="{DynamicResource AccentBrush}"
                    CornerRadius="10"
                    Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Database Auditor"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="White"
                                   FontFamily="{StaticResource PrimaryFont}"/>
                        <TextBlock Text="Enterprise Schema Comparison &amp; Audit Platform"
                                   FontSize="13" Foreground="#BBDEFB"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="Compare schemas across SQL Server, Oracle, PostgreSQL, MySQL and MariaDB"
                                   FontSize="11" Foreground="#90CAF9"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="#1A000000"
                            CornerRadius="8"
                            Padding="16,12"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="WelcomeDate"
                                       FontSize="11" Foreground="#90CAF9"
                                       FontFamily="{StaticResource MonoFont}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Three Star Infotech"
                                       FontSize="10" Foreground="#64B5F6"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Stat Cards Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Total Connections -->
                <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="TOTAL CONNECTIONS"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="{StaticResource PrimaryFont}"/>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="6"
                                    Padding="8,4">
                                <TextBlock Text="⊞"
                                           FontSize="14" Foreground="White"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="TotalConnectionsText"
                                   Text="0"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Configured databases"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="{StaticResource PrimaryFont}"/>
                    </StackPanel>
                </Border>

                <!-- Production -->
                <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="PRODUCTION"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="{StaticResource PrimaryFont}"/>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource DeletedBgBrush}"
                                    CornerRadius="6"
                                    Padding="8,4">
                                <TextBlock Text="⚡" FontSize="14"
                                           Foreground="{DynamicResource DeletedBrush}"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="ProductionConnectionsText"
                                   Text="0"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource DeletedBrush}"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Production connections"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="{StaticResource PrimaryFont}"/>
                    </StackPanel>
                </Border>

                <!-- Development -->
                <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="DEVELOPMENT"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="{StaticResource PrimaryFont}"/>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource AddedBgBrush}"
                                    CornerRadius="6"
                                    Padding="8,4">
                                <TextBlock Text="⚙" FontSize="14"
                                           Foreground="{DynamicResource AddedBrush}"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="DevConnectionsText"
                                   Text="0"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource AddedBrush}"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="Dev/QA connections"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="{StaticResource PrimaryFont}"/>
                    </StackPanel>
                </Border>

                <!-- Supported DBs -->
                <Border Grid.Column="6" Style="{StaticResource StatCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="SUPPORTED DBS"
                                       FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontFamily="{StaticResource PrimaryFont}"/>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource ModifiedBgBrush}"
                                    CornerRadius="6"
                                    Padding="8,4">
                                <TextBlock Text="▦" FontSize="14"
                                           Foreground="{DynamicResource ModifiedBrush}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="5"
                                   FontSize="32" FontWeight="Bold"
                                   Foreground="{DynamicResource ModifiedBrush}"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Text="SQL Server · Oracle · PG · MySQL · MariaDB"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Capabilities Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- Quick Actions -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Quick Actions"
                                   Style="{StaticResource TextHeading3}"
                                   Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    CornerRadius="8" Padding="16,14"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnQuickCompare">
                                <StackPanel helpers:StackPanelHelper.Spacing="6">
                                    <TextBlock Text="⇌" FontSize="22"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="New Comparison"
                                               FontSize="12" FontWeight="SemiBold"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Compare two database schemas"
                                               FontSize="10"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="2"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    CornerRadius="8" Padding="16,14"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnQuickConnections">
                                <StackPanel helpers:StackPanelHelper.Spacing="6">
                                    <TextBlock Text="⊞" FontSize="22"
                                               Foreground="{DynamicResource AddedBrush}"/>
                                    <TextBlock Text="Add Connection"
                                               FontSize="12" FontWeight="SemiBold"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Configure a new database connection"
                                               FontSize="10"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    CornerRadius="8" Padding="16,14"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnQuickReports">
                                <StackPanel helpers:StackPanelHelper.Spacing="6">
                                    <TextBlock Text="📄" FontSize="22"/>
                                    <TextBlock Text="Export Report"
                                               FontSize="12" FontWeight="SemiBold"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Export results to Excel or PDF"
                                               FontSize="10"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="2"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    CornerRadius="8" Padding="16,14"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="OnQuickResults">
                                <StackPanel helpers:StackPanelHelper.Spacing="6">
                                    <TextBlock Text="≡" FontSize="22"
                                               Foreground="{DynamicResource ModifiedBrush}"/>
                                    <TextBlock Text="View Results"
                                               FontSize="12" FontWeight="SemiBold"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="View last comparison results"
                                               FontSize="10"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Recent Connections panel -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Recent Connections"
                                   Style="{StaticResource TextHeading3}"
                                   Margin="0,0,0,12"/>

                        <ItemsControl x:Name="RecentConnectionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- DB Type icon -->
                                            <Border Grid.Column="0"
                                                    Width="28" Height="28"
                                                    Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="6">
                                                <TextBlock Text="DB"
                                                           FontSize="9" FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource PrimaryFont}"/>
                                            </Border>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           FontFamily="{StaticResource PrimaryFont}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock FontSize="10"
                                                           FontFamily="{StaticResource PrimaryFont}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                                    <Run Text="{Binding DatabaseType}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Database}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Border Grid.Column="3"
                                                    CornerRadius="10"
                                                    Padding="6,2"
                                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Environment}"
                                                           FontSize="9"
                                                           FontFamily="{StaticResource PrimaryFont}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoConnectionsText"
                                   Text="No connections configured yet."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontStyle="Italic"
                                   HorizontalAlignment="Center"
                                   Margin="0,20"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Supported Objects -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Comparison Capabilities"
                               Style="{StaticResource TextHeading3}"
                               Margin="0,0,0,16"/>
                    <ItemsControl>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Items>
                            <Border Style="{StaticResource CapabilityBadgeStyle}">
                                <TextBlock Text="📋 Tables" Style="{StaticResource CapBadgeTextStyle}"/>
                            </Border>
                            <Border Style="{StaticResource CapabilityBadgeStyle}">
                                <TextBlock Text="📌 Columns" Style="{StaticResource CapBadgeTextStyle}"/>
                            </Border>
                            <Border Style="{StaticResource CapabilityBadgeStyle}">
                                <TextBlock Text="⚙ Stored Procedures" Style="{StaticResource CapBadgeTextStyle}"/>
                            </Border>
                            <Border Style="{StaticResource CapabilityBadgeStyle}">
                                <TextBlock Text="👁 Views" Style="{StaticResource CapBadgeTextStyle}"/>
                            </Border>
                            <Border Style="{StaticResource CapabilityBadgeStyle}">
                                <TextBlock Text="ƒ Functions" Style="{StaticResource CapBadgeTextStyle}"/>
                            </Border>
                            <Border Style="{StaticResource CapabilityBadgeStyle}">
                                <TextBlock Text="⚡ Triggers" Style="{StaticResource CapBadgeTextStyle}"/>
                            </Border>
                            <Border Style="{StaticResource CapabilityBadgeStyle}">
                                <TextBlock Text="🔒 Constraints" Style="{StaticResource CapBadgeTextStyle}"/>
                            </Border>
                            <Border Style="{StaticResource CapabilityBadgeStyle}">
                                <TextBlock Text="🗂 Indexes" Style="{StaticResource CapBadgeTextStyle}"/>
                            </Border>
                            <Border Style="{StaticResource CapabilityBadgeStyle}">
                                <TextBlock Text="📊 Full Database" Style="{StaticResource CapBadgeTextStyle}"/>
                            </Border>
                        </ItemsControl.Items>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
