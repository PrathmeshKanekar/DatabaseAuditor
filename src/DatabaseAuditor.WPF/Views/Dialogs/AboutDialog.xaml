<Window x:Class="DatabaseAuditor.WPF.Views.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Database Auditor" Height="320" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMD}" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock Text="Database Auditor" Style="{DynamicResource TextHeading2}" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Version 1.0.0" Style="{DynamicResource TextCaption}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <Separator Grid.Row="1"/>

            <!-- Info -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <TextBlock Text="A premium database schema auditing and comparison tool built with Clean Architecture, WPF, and MVVM." Style="{DynamicResource TextBody}" TextAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Designed for SQL Server, Oracle, PostgreSQL, and MySQL databases." Style="{DynamicResource TextCaption}" TextAlignment="Center"/>
            </StackPanel>

            <!-- Buttons / Footer -->
            <StackPanel Grid.Row="3">
                <Button Content="Close" Click="Close_Click" Style="{DynamicResource ButtonStyle}" Width="100" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="© 2026 Three Star Infotech. All rights reserved." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
