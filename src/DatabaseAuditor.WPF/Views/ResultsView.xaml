<UserControl x:Class="DatabaseAuditor.WPF.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DatabaseAuditor.WPF.Views"
             mc:Ignorable="d" 
             Padding="24"
             d:DesignHeight="700" d:DesignWidth="1100">
    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Info -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <!-- Filter Bar -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Audit Execution Results" Style="{DynamicResource TextHeading2}" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding SessionInfo}" Style="{DynamicResource TextBody}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding ExecutionTime}" Style="{DynamicResource TextCaption}"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding ExportResultsCommand}" Style="{DynamicResource ButtonStyle}" Content="Export Report" Width="140" Height="36" VerticalAlignment="Center"/>
        </Grid>

        <!-- Filter Bar -->
        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Search -->
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="20" />
                    <!-- Filter Checkboxes -->
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <!-- Action -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Grid Grid.Column="0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{DynamicResource TextBoxStyle}"
                             Padding="10,6" />
                    <TextBlock Text="Filter by object name..." 
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Filter Checkboxes -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding ShowAdded}" Content="{Binding AddedCount, StringFormat='Added ({0})'}" Foreground="{DynamicResource AddedBrush}" Margin="0,0,16,0"/>
                    <CheckBox IsChecked="{Binding ShowDeleted}" Content="{Binding DeletedCount, StringFormat='Deleted ({0})'}" Foreground="{DynamicResource DeletedBrush}" Margin="0,0,16,0"/>
                    <CheckBox IsChecked="{Binding ShowModified}" Content="{Binding ModifiedCount, StringFormat='Modified ({0})'}" Foreground="{DynamicResource ModifiedBrush}" Margin="0,0,16,0"/>
                    <CheckBox IsChecked="{Binding ShowUnchanged}" Content="{Binding UnchangedCount, StringFormat='Unchanged ({0})'}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Reset button -->
                <Button Grid.Column="4" Command="{Binding ClearFiltersCommand}" Style="{DynamicResource ButtonStyle}" Content="Reset Filters" Padding="12,6"/>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="4" Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="150" />
                <RowDefinition Height="8" />
                <RowDefinition Height="2.5*" MinHeight="150" />
            </Grid.RowDefinitions>

            <!-- Grid of Results -->
            <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding ResultsView}"
                          SelectedItem="{Binding SelectedResult}"
                          Style="{DynamicResource DataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Object Type" Binding="{Binding ObjectType}" Width="1*" />
                        <DataGridTextColumn Header="Schema" Binding="{Binding SchemaName}" Width="0.8*" />
                        <DataGridTextColumn Header="Object Name" Binding="{Binding ObjectName}" Width="2*" />
                        <DataGridTemplateColumn Header="Change Type" Width="1.2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding ChangeType, Converter={StaticResource ChangeTypeToBgColorConverter}}"
                                            CornerRadius="{DynamicResource RadiusSM}"
                                            Padding="6,3"
                                            HorizontalAlignment="Left"
                                            Margin="4,2">
                                        <TextBlock Text="{Binding ChangeType, Converter={StaticResource ChangeTypeToTextConverter}}"
                                                   Foreground="{Binding ChangeType, Converter={StaticResource ChangeTypeToColorConverter}}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status Details" Binding="{Binding Status}" Width="1.5*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Splitting Grid Splitter -->
            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS"/>

            <!-- Side-by-side DDL comparison Panel -->
            <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="12">
                <Grid>
                    <!-- Detail View (When a row is selected) -->
                    <Grid Visibility="{Binding SelectedResult, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <TextBlock Text="{Binding SelectedResult.ObjectName, StringFormat='DDL Definition Compare: \{0\}'}" Style="{DynamicResource SectionHeaderStyle}" Margin="0"/>
                            <Button Command="{Binding CopySelectedRowCommand}" Style="{DynamicResource ButtonStyle}" Content="Copy Row Text" HorizontalAlignment="Right" Padding="8,4"/>
                        </Grid>

                        <Separator Grid.Row="1"/>

                        <!-- Side by Side Source and Target DDL Panels -->
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Differences List wrapped in a ScrollViewer to prevent pushing the DDL boxes off screen -->
                            <ScrollViewer Grid.Row="0" MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SelectedResult.Differences}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ModifiedBgBrush}" CornerRadius="{DynamicResource RadiusSM}" Padding="8,4" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding}" Foreground="{DynamicResource ModifiedBrush}" TextWrapping="Wrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Source DDL -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Source Definition (Baseline)" Style="{DynamicResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Grid.Row="1" Text="{Binding SelectedResult.SourceValue}" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="{DynamicResource MonoFont}" FontSize="11" Background="{DynamicResource SurfaceBrush}" BorderThickness="0" Padding="8"/>
                                </Grid>

                                <!-- Target DDL -->
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Target Definition (Compare)" Style="{DynamicResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Grid.Row="1" Text="{Binding SelectedResult.TargetValue}" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="{DynamicResource MonoFont}" FontSize="11" Background="{DynamicResource SurfaceBrush}" BorderThickness="0" Padding="8"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Placeholder (When no row is selected) -->
                    <Grid Visibility="{Binding SelectedResult, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="Select a row in the results table to view and compare its SQL DDL definitions side-by-side." Style="{DynamicResource TextCaption}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- No Results state -->
        <Grid Grid.Row="4" Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="☰" FontSize="48" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="No comparison results loaded" Style="{DynamicResource TextHeading3}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Go to 'Database Compare' tab and execute a comparison audit first." Style="{DynamicResource TextCaption}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
