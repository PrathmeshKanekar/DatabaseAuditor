<UserControl x:Class="DatabaseAuditor.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DatabaseAuditor.WPF.Views"
             mc:Ignorable="d" 
             Padding="24"
             d:DesignHeight="600" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Application Settings" Style="{DynamicResource TextHeading2}" FontWeight="Bold"/>
                    <TextBlock Text="Configure user preferences, system behaviors, and logs." Style="{DynamicResource TextCaption}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding AppVersion, StringFormat='Version: \{0\}'}" Style="{DynamicResource TextCaption}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Configuration Grid -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- General Preferences -->
                <StackPanel Grid.Column="0">
                    <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="General Preferences" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,12"/>
                            
                            <!-- Theme Selection -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Interface Theme" Style="{DynamicResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding ThemeOptions}"
                                          SelectedItem="{Binding SelectedTheme}"
                                          Style="{DynamicResource ComboBoxStyle}"
                                          Padding="10,6"/>
                            </StackPanel>

                            <!-- Log Level -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Logging Level" Style="{DynamicResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding LogLevelOptions}"
                                          SelectedItem="{Binding SelectedLogLevel}"
                                          Style="{DynamicResource ComboBoxStyle}"
                                          Padding="10,6"/>
                            </StackPanel>

                            <Separator Margin="0,0,0,12"/>

                            <!-- Animations & Auto-Refresh -->
                            <CheckBox IsChecked="{Binding EnableAnimations}" Style="{DynamicResource CheckBoxStyle}" Content="Enable UI Animations" Margin="0,0,0,12"/>
                            
                            <StackPanel>
                                <CheckBox IsChecked="{Binding AutoRefresh}" Style="{DynamicResource CheckBoxStyle}" Content="Enable Auto-Refresh" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" IsEnabled="{Binding AutoRefresh}" Margin="24,0,0,0">
                                    <TextBlock Text="Interval (seconds):" Style="{DynamicResource TextCaption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding AutoRefreshInterval}" Width="80" Style="{DynamicResource TextBoxStyle}" Padding="6"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Path Configurations -->
                    <Border Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Storage &amp; Folders" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,12"/>

                            <!-- Default Export directory -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Default Reports Export Path" Style="{DynamicResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding DefaultExportDirectory}" Style="{DynamicResource TextBoxStyle}" Padding="10,6" IsReadOnly="True"/>
                                    <Button Grid.Column="2" Command="{Binding BrowseExportDirectoryCommand}" Style="{DynamicResource ButtonStyle}" Content="Browse" Padding="10,6"/>
                                </Grid>
                            </StackPanel>

                            <!-- Log Directory -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Diagnostic Logs Folder" Style="{DynamicResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding LogDirectory}" Style="{DynamicResource TextBoxStyle}" Padding="10,6" IsReadOnly="True"/>
                                    <Button Grid.Column="2" Command="{Binding BrowseLogDirectoryCommand}" Style="{DynamicResource ButtonStyle}" Content="Browse" Padding="10,6"/>
                                </Grid>
                            </StackPanel>

                            <Separator Margin="0,0,0,12"/>

                            <!-- Directory Launchers -->
                            <UniformGrid Columns="2">
                                <Button Command="{Binding OpenAppDataFolderCommand}" Style="{DynamicResource ButtonStyle}" Content="Open AppData Folder" Margin="0,0,6,0"/>
                                <Button Command="{Binding OpenLogFolderCommand}" Style="{DynamicResource ButtonStyle}" Content="Open Logs Folder" Margin="6,0,0,0"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- System / Performance Settings -->
                <Border Grid.Column="2" Style="{DynamicResource CardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Performance &amp; Connection Limits" Style="{DynamicResource SectionHeaderStyle}" Margin="0,0,0,12"/>

                        <!-- Max Parallel connections -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Max Parallel Connections" Style="{DynamicResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding ParallelOptions}"
                                      SelectedItem="{Binding MaxParallelConnections}"
                                      Style="{DynamicResource ComboBoxStyle}"
                                      Padding="10,6"/>
                            <TextBlock Text="Maximum concurrent connections allowed during batch audits." Style="{DynamicResource TextCaption}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Connection timeout -->
                        <StackPanel Margin="0,8,0,12">
                            <TextBlock Text="Connection Timeout (seconds)" Style="{DynamicResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding TimeoutOptions}"
                                      SelectedItem="{Binding ConnectionTimeout}"
                                      Style="{DynamicResource ComboBoxStyle}"
                                      Padding="10,6"/>
                            <TextBlock Text="Wait duration before marking database connection as failed." Style="{DynamicResource TextCaption}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Command timeout -->
                        <StackPanel Margin="0,8,0,16">
                            <TextBlock Text="Command / Query Timeout (seconds)" Style="{DynamicResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding TimeoutOptions}"
                                      SelectedItem="{Binding CommandTimeout}"
                                      Style="{DynamicResource ComboBoxStyle}"
                                      Padding="10,6"/>
                            <TextBlock Text="Query execution limit for complex schema indexing scripts." Style="{DynamicResource TextCaption}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Separator Margin="0,0,0,12"/>
                        
                        <CheckBox IsChecked="{Binding ShowUnchangedObjects}" Style="{DynamicResource CheckBoxStyle}" Content="Show Unchanged Database Objects by Default"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Actions panel -->
            <Border Style="{DynamicResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Command="{Binding ResetToDefaultsCommand}" Style="{DynamicResource ButtonStyle}" Content="Reset to Defaults" Width="140"/>
                    
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Style="{DynamicResource TextBody}" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Button Grid.Column="2" Command="{Binding SaveSettingsCommand}" Style="{DynamicResource ButtonStyle}" Content="Save Settings" Width="140" Background="{DynamicResource AccentBrush}" Foreground="White"
                            IsEnabled="{Binding HasChanges}"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
